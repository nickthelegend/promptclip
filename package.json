{
  "name": "promptclip",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/nickthelegend/promptclip.git"
  },
  "description": "A background prompt picker for your clipboard.",
  "main": "src/main.js",
  "author": "PromptClip",
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "test": "node --test test/*.test.js",
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.promptclip.app",
    "productName": "PromptClip",
    "icon": "build/promptclip.png",
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/promptclip.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "PromptClip needs access to Apple Notes to import the prompts you choose to keep locally."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.0.12"
  }
}
